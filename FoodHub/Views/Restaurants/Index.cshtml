@model List<FoodHub.Models.Restaurant>
@{
    ViewData["Title"] = "Restaurants";
}

<h3>Restaurants Count @Model.Count </h3>
<table>
    <thead>
        <tr>
        <th>Id</th>
        <th>Name</th>
            <th>Rating</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var restaurant in Model)
        {
            <tr>
                <td>@restaurant.Id</td>
                <td>@restaurant.Name</td>
                <td>@restaurant.Rating</td>
            </tr>
        }
    </tbody>
</table>

